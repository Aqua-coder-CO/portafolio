# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Correo donde recibirás los mensajes del formulario.
# Debe coincidir con el email de tu cuenta Resend si usas onboarding@resend.dev
CONTACT_TO_EMAIL=tu@gmail.com

# Opcional. En pruebas usa el remitente por defecto de Resend.
# Con dominio verificado en Resend, usa tu propio remitente para mejor entrega.
# RESEND_FROM_EMAIL=Portafolio <notificaciones@tudominio.com>
